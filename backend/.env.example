# Copy this file to ".env" and fill in real values. Never commit ".env".
DJANGO_SECRET_KEY=change-me
DEBUG=True
DATABASE_NAME=your_database_name
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Optional (defaults are set in config/settings.py)
# ALLOWED_HOSTS=localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Online status of waiters: a user is "online" while logged in and seen within this many
# seconds (any authenticated request counts as activity). Keep it well above the clients'
# polling interval.
# ONLINE_TIMEOUT_SECONDS=120
# ACTIVITY_TOUCH_INTERVAL_SECONDS=30

# Public URL of the React frontend; it is embedded in every printed table QR code
# (<FRONTEND_BASE_URL>/menu?restaurant_id=..&table=..&token=..).
# PRODUCTION: you MUST set this to the deployed frontend URL (e.g. https://app.example.com)
# BEFORE exporting QR PDFs; the default below only works on a developer machine, and
# QR codes printed with it cannot be fixed later. `manage.py check` warns if DEBUG is
# off and this still points at localhost.
# FRONTEND_BASE_URL=http://localhost:5173
